# Portal de clientes: nada de listar carpetas ni abrir archivos internos.
Options -Indexes
<FilesMatch "^(config|config\.example|lib)\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "^demo-datos\.json$">
  Require all denied
</FilesMatch>

# Que el navegador revise siempre si hay una versión nueva de la página, el diseño y el script (evita ver el diseño viejo después de actualizar).
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
